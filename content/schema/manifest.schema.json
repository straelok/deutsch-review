{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worttrieb.app/schema/content-manifest-v1.json",
  "title": "Worttrieb content manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "content_version",
    "schema_version",
    "minimum_app_content_schema",
    "bundle_path",
    "sha256",
    "compressed_size",
    "uncompressed_size",
    "published_at"
  ],
  "properties": {
    "manifest_version": { "const": 1 },
    "content_version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"
    },
    "schema_version": { "const": 1 },
    "minimum_app_content_schema": { "type": "integer", "minimum": 1 },
    "bundle_path": {
      "type": "string",
      "pattern": "^content/versions/[A-Za-z0-9._-]+/catalog\\.json\\.gz$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "compressed_size": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "uncompressed_size": { "type": "integer", "minimum": 1, "maximum": 5242880 },
    "published_at": { "type": "string", "format": "date-time" }
  }
}
