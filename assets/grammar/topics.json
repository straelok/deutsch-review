      ],
      "explanation_ru": [
        "Глагол сообщает, что кто-то делает или что происходит: lernen, wohnen, sein.",
        "В словаре глагол записан в инфинитиве. В предложении его форма изменяется."
      ],
      "table": [["lernen", "учить"], ["wohnen", "жить"], ["sein", "быть"]],
      "trainable": false
